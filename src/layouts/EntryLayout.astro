---
import BaseLayout from './BaseLayout.astro';
import Backlinks from '../components/Backlinks.astro';

interface Props {
  titolo: string;
  meta?: string;
  stato?: string;
  tag?: string[];
  backlinksUrl: string;
  immagine?: string;
}
const { titolo, meta, stato, tag = [], backlinksUrl, immagine } = Astro.props;

const sezioni: Record<string, string> = {
  diario: 'Diario',
  personaggi: 'Personaggi',
  png: 'Png',
  luoghi: 'Luoghi',
  riassunto: 'Riassunto',
};
const sezione = sezioni[backlinksUrl.split('/')[1]];
---
<BaseLayout title={titolo}>
  <article data-pagefind-body data-pagefind-filter={sezione && `sezione:${sezione}`}>
    <header class="entry-header">
      {immagine && <img class="entry-image" src={immagine} alt={titolo} />}
      <h1 class="page-title" data-pagefind-weight="10">{titolo}</h1>
      {meta && <p class="entry-meta" data-pagefind-ignore>{meta}</p>}
      {(stato || tag.length > 0) && (
        <div class="badge-row" data-pagefind-ignore>
          {stato && <span class={`badge badge-${stato}`}>{stato}</span>}
          {tag.map((t) => <span class="badge">{t}</span>)}
        </div>
      )}
    </header>
    <div class="entry-content">
      <slot />
    </div>
    <div data-pagefind-ignore>
      <Backlinks url={backlinksUrl} />
      <slot name="fine" />
    </div>
  </article>
</BaseLayout>
