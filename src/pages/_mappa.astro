---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const luoghi = await getCollection('luoghi');
const byId = Object.fromEntries(luoghi.map((l) => [l.id, l]));

// Coordinate scelte a mano sull'immagine public/images/mappe/barovia.png
// (1493x1053), allineate ai punti di riferimento disegnati sulla mappa
// stessa. Include solo i luoghi "di punta": le tappe interne a Vallaki
// restano elencate nella pagina di Vallaki.
const nodi = [
  { id: 'villaggio-di-barovia', x: 1050, y: 380 },
  { id: 'castello-ravenloft', x: 1155, y: 400, grande: true },
  { id: 'vallaki', x: 730, y: 300 },
  { id: 'torre-abbandonata', x: 535, y: 455 },
  { id: 'wizard-of-wines', x: 540, y: 570 },
  { id: 'argynvostholt', x: 795, y: 265 },
  { id: 'accampamento-dei-vistani', x: 1405, y: 410 },
]
  .map((n) => ({ ...n, entry: byId[n.id] }))
  .filter((n) => n.entry);
---
<BaseLayout title="Mappa">
  <h1 class="page-title">Mappa di Barovia</h1>
  <p class="page-lede">
    La mappa della valle, annotata con le tappe che il gruppo ha raggiunto o
    di cui ha sentito parlare.
  </p>

  <div class="map-wrap">
    <svg class="map-svg" viewBox="0 0 1493 1053" role="img" aria-labelledby="map-title" xmlns="http://www.w3.org/2000/svg">
      <title id="map-title">Mappa di Barovia con i luoghi incontrati dal gruppo</title>
      <defs>
        <radialGradient id="castle-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#7a1f2b" stop-opacity="0.6" />
          <stop offset="100%" stop-color="#7a1f2b" stop-opacity="0" />
        </radialGradient>
      </defs>

      <image href="/images/mappe/barovia.png" x="0" y="0" width="1493" height="1053" />

      {nodi.map((n) => {
        const visitato = n.entry!.data.visitato;
        const r = n.grande ? 16 : 11;
        return (
          <a href={`/luoghi/${n.id}`} class="map-pin-link">
            {n.grande && <circle cx={n.x} cy={n.y} r={r * 3} fill="url(#castle-glow)" />}
            <circle
              cx={n.x}
              cy={n.y}
              r={r}
              class:list={['map-pin', { 'map-pin-visitato': visitato, 'map-pin-ignoto': !visitato }]}
            />
            <rect
              x={n.x - n.entry!.data.titolo.length * 3.6 - 8}
              y={n.y - r - 32}
              width={n.entry!.data.titolo.length * 7.2 + 16}
              height="22"
              rx="4"
              class="map-pin-label-bg"
            />
            <text
              x={n.x}
              y={n.y - r - 16}
              class:list={['map-pin-label', { 'map-pin-label-ignoto': !visitato }]}
              text-anchor="middle"
            >
              {n.entry!.data.titolo}
            </text>
          </a>
        );
      })}
    </svg>
  </div>

  <div class="map-legend">
    <span class="map-legend-item"><span class="map-legend-dot map-legend-dot-visitato" aria-hidden="true"></span>Visitato</span>
    <span class="map-legend-item"><span class="map-legend-dot map-legend-dot-ignoto" aria-hidden="true"></span>Conosciuto, non visitato</span>
  </div>

  <p class="map-footnote">
    Le tappe interne a Vallaki (locanda, chiesa, bottega, villa del
    borgomastro) non compaiono qui singolarmente: sono elencate nella
    pagina di <a href="/luoghi/vallaki">Vallaki</a>. Elenco completo dei
    luoghi in <a href="/luoghi/">Luoghi</a>.
  </p>
</BaseLayout>
