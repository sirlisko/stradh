---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardGrid from '../../components/CardGrid.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const characters = (await getCollection('personaggi')).sort((a, b) =>
  a.data.titolo.localeCompare(b.data.titolo)
);
---
<BaseLayout title="Personaggi" description="I personaggi della compagnia: chi sono, da dove vengono e cosa hanno affrontato finora.">
  <h1 class="page-title">Personaggi</h1>
  <p class="page-lede">Gli avventurieri del gruppo.</p>
  <CardGrid>
    {characters.map((p) => (
      <Card
        href={`/personaggi/${p.id}`}
        title={p.data.titolo}
        excerpt={p.data.estratto}
        meta={[p.data.classe, p.data.giocatore && `Giocatore: ${p.data.giocatore}`].filter(Boolean).join(' · ')}
        status={p.data.stato}
        image={p.data.immagine}
      />
    ))}
  </CardGrid>
</BaseLayout>
