---
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const npcs = await getCollection('png');
  return npcs.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const meta = [entry.data.ruolo, entry.data.luogo, entry.data.fazione].filter(Boolean).join(' · ');
---
<EntryLayout
  title={entry.data.titolo}
  meta={meta}
  status={entry.data.stato}
  tags={entry.data.tag}
  backlinksUrl={`/png/${entry.id}`}
>
  <Content />
</EntryLayout>
