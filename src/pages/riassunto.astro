---
import { getEntry, render } from 'astro:content';
import EntryLayout from '../layouts/EntryLayout.astro';

const entry = await getEntry('riassunto', 'overview');
const { Content } = await render(entry);
---
<EntryLayout
  title={entry.data.titolo}
  description="Il riassunto della campagna: la storia della compagnia dalle origini fino all'ultima sessione giocata."
  backlinksUrl="/riassunto"
>
  <Content />
</EntryLayout>
