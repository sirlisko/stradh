---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardGrid from '../../components/CardGrid.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const places = (await getCollection('luoghi')).sort((a, b) => a.data.titolo.localeCompare(b.data.titolo));
---
<BaseLayout title="Luoghi" description="I luoghi visitati o sentiti nominare dalla compagnia nel corso della campagna.">
  <h1 class="page-title">Luoghi</h1>
  <p class="page-lede">Villaggi, castelli, foreste e altri luoghi di Barovia.</p>
  <CardGrid>
    {places.map((l) => (
      <Card
        href={`/luoghi/${l.id}`}
        title={l.data.titolo}
        excerpt={l.data.estratto}
        meta={[l.data.tipo, l.data.regione].filter(Boolean).join(' · ')}
      />
    ))}
  </CardGrid>
</BaseLayout>
