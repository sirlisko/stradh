---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { romano, dataLunga } from '../lib/romano';

const sessioni = (await getCollection('sessions')).sort((a, b) => b.data.numero - a.data.numero);
const ultima = sessioni[0];

const personaggi = (await getCollection('personaggi')).sort((a, b) =>
  a.data.titolo.localeCompare(b.data.titolo)
);
const immaginiComplete: Record<string, string> = {
  artemis: '/images/personaggi/artemis-full.png',
  'don-matteor': '/images/personaggi/don-matteor-full.png',
  erieth: '/images/personaggi/erieth-full.png',
  tarik: '/images/personaggi/tarik-full.png',
};
const gruppo = personaggi.filter((p) => immaginiComplete[p.id]);
---
<BaseLayout title="Home" masthead>
  <p class="prossima-sessione" id="prossima-sessione" hidden>
    Prossima sessione: <span id="prossima-sessione-value"></span>
  </p>

  {ultima && (
    <section class="ultima-sessione">
      <p class="kicker kicker-split">
        <span>Ultima sessione · {romano(ultima.data.numero)}</span>
        <span>{dataLunga(ultima.data.data)}</span>
      </p>
      <h2><a href={`/diario/${ultima.id}`}>{ultima.data.titolo}</a></h2>
      {ultima.data.estratto && <p class="capolettera">{ultima.data.estratto}</p>}
      <p class="continua"><a href={`/diario/${ultima.id}`}>Continua a leggere</a> &rarr;</p>
    </section>
  )}

  <script>
    const endpoint = 'https://cms.sirlisko.com/items/stradh';
    const item = document.getElementById('prossima-sessione');
    const valueEl = document.getElementById('prossima-sessione-value');

    fetch(endpoint)
      .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
      .then(({ data }) => {
        if (!data?.next_session || !item || !valueEl) return;
        const dataSessione = new Date(data.next_session);
        if (Number.isNaN(dataSessione.getTime())) return;
        if (dataSessione.getTime() < Date.now()) return; // sessione già passata

        const giorno = dataSessione.toLocaleDateString('it-IT', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
        });
        const ora = dataSessione.toLocaleTimeString('it-IT', {
          hour: '2-digit',
          minute: '2-digit',
        });

        valueEl.textContent = `${giorno} alle ${ora}`;
        item.hidden = false;
      })
      .catch(() => {
        // CMS non raggiungibile: nessuna sessione mostrata.
      });
  </script>

  {gruppo.length > 0 && (
    <section>
      <div class="fregio" aria-hidden="true">&#8258;</div>
      <h2 class="section-title">La compagnia</h2>
      <div class="cast-grid">
        {gruppo.map((p) => (
          <a class="cast-portrait" href={`/personaggi/${p.id}`}>
            <img src={immaginiComplete[p.id]} alt="" loading="lazy" />
            <span>{p.data.titolo}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section>
    <div class="fregio" aria-hidden="true">&#8258;</div>
    <h2 class="section-title">Indice delle sessioni</h2>
    <ol class="indice">
      {sessioni.map((s) => (
        <li>
          <span class="indice-numero">{romano(s.data.numero)}</span>
          <a href={`/diario/${s.id}`}>{s.data.titolo}</a>
          <span class="indice-puntini" aria-hidden="true"></span>
          <span class="indice-data">
            {s.data.data.toLocaleDateString('it-IT', { day: 'numeric', month: 'short' })}
          </span>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
