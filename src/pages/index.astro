---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const sessioni = (await getCollection('sessions')).sort((a, b) => b.data.numero - a.data.numero);
const ultima = sessioni[0];

const personaggi = (await getCollection('personaggi')).sort((a, b) =>
  a.data.titolo.localeCompare(b.data.titolo)
);
const immaginiComplete: Record<string, string> = {
  artemis: '/images/personaggi/artemis-full.png',
  'don-matteor': '/images/personaggi/don-matteor-full.png',
  erieth: '/images/personaggi/erieth-full.png',
  tarik: '/images/personaggi/tarik-full.png',
};
const gruppo = personaggi.filter((p) => immaginiComplete[p.id]);
---
<BaseLayout title="Home">
  <div class="hero">
    <h1 class="page-title">La Maledizione di Strahd</h1>
    <div class="ornament" aria-hidden="true">❖</div>
    <p>
      Diario della campagna: sessioni giocate, personaggi, PNG incontrati e i luoghi di Barovia.
    </p>
  </div>

  <div class="session-status">
    {ultima && (
      <div class="session-status-item">
        <span class="session-status-label">Ultima sessione</span>
        <a class="session-status-value" href={`/diario/${ultima.id}`}>{ultima.data.titolo}</a>
      </div>
    )}
    <div class="session-status-item" id="prossima-sessione" hidden>
      <span class="session-status-label">Prossima sessione</span>
      <span class="session-status-value" id="prossima-sessione-value"></span>
    </div>
  </div>

  <script>
    const endpoint = 'https://cms.sirlisko.com/items/stradh';
    const item = document.getElementById('prossima-sessione');
    const valueEl = document.getElementById('prossima-sessione-value');

    fetch(endpoint)
      .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
      .then(({ data }) => {
        if (!data?.next_session || !item || !valueEl) return;
        const dataSessione = new Date(data.next_session);
        if (Number.isNaN(dataSessione.getTime())) return;
        if (dataSessione.getTime() < Date.now()) return; // sessione già passata

        const giorno = dataSessione.toLocaleDateString('it-IT', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
        });
        const ora = dataSessione.toLocaleTimeString('it-IT', {
          hour: '2-digit',
          minute: '2-digit',
        });

        valueEl.innerHTML = `${giorno}<br/>alle ${ora}`;
        item.hidden = false;
      })
      .catch(() => {
        // CMS non raggiungibile: nessuna sessione mostrata.
      });
  </script>

  {gruppo.length > 0 && (
    <div class="cast-grid">
      {gruppo.map((p) => (
        <a class="cast-portrait" href={`/personaggi/${p.id}`}>
          <img src={immaginiComplete[p.id]} alt={p.data.titolo} loading="lazy" />
          <span class="cast-portrait-name">{p.data.titolo}</span>
        </a>
      ))}
    </div>
  )}

  <nav class="card-grid hero-nav">
    <a class="card" href="/riassunto/"><h3>Riassunto</h3><p>La storia della campagna fin qui, in breve.</p></a>
    <a class="card" href="/diario/"><h3>Diario</h3><p>Il resoconto di ogni sessione giocata.</p></a>
    <a class="card" href="/personaggi/"><h3>Personaggi</h3><p>Gli eroi (o sciagurati) del gruppo.</p></a>
    <a class="card" href="/png/"><h3>PNG</h3><p>Alleati, nemici e comparse di Barovia.</p></a>
    <a class="card" href="/luoghi/"><h3>Luoghi</h3><p>Villaggi, castelli e luoghi maledetti.</p></a>
    <a class="card" href="/cronologia/"><h3>Cronologia</h3><p>La storia della campagna in ordine, sessione dopo sessione.</p></a>
  </nav>
</BaseLayout>
